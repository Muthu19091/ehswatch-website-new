# Copy to .env.local and fill in. Do NOT commit real values (.env* is git-ignored).

# App base path — everything is served under this prefix.
# Stage value:
NEXT_PUBLIC_BASE_PATH=/ehswatch-stage

# Cloudflare Turnstile site key (public) used by the forms.
# Get the real key from the team (password manager) or the Cloudflare Turnstile dashboard.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
