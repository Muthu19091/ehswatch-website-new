# Copy to .env.local and fill in. Do NOT commit real values (.env* is git-ignored).

# ── App base path ──────────────────────────────────────────────────────────
# Everything is served under this prefix. Empty = root-domain deploy.
# Stage value:
NEXT_PUBLIC_BASE_PATH=/ehswatch-stage

# ── CMS API ────────────────────────────────────────────────────────────────
# Public (browser) base — must be reachable over HTTPS from the client.
NEXT_PUBLIC_CMS_API_BASE=https://stage.odigma.ooo/ehswatch-cms/api/v1
# Server-side (SSR) base — the internal URL the Next server calls; keep it
# http/localhost when the CMS is on the same host to skip the Cloudflare hop.
CMS_API_SSR_BASE=http://stage.odigma.ooo/ehswatch-cms/api/v1

# ── Cloudflare Turnstile ─────────────────────────────────────────────────────
# Public site key for the forms. The real widget only renders with a non-test
# key. NOTE: the CMS Site Settings captcha.site_key takes precedence over this.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
