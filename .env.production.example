# Production template — copy to .env (or .env.production) on the prod host and
# fill in real values. Do NOT commit real values.

# Root-domain deploy => empty. Set a subpath only if serving under one.
NEXT_PUBLIC_BASE_PATH=

# Point BOTH at the PRODUCTION CMS.
#  - PUBLIC:  the HTTPS URL the browser can reach.
#  - SSR:     an internal/localhost URL the Next server uses (same host as CMS).
NEXT_PUBLIC_CMS_API_BASE=https://YOUR-PROD-CMS-DOMAIN/api/v1
CMS_API_SSR_BASE=http://127.0.0.1/api/v1

# Optional here (CMS Site Settings can supply the site key instead).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
